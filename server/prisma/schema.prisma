generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  email                  String             @unique @db.VarChar(254)
  displayName            String             @map("display_name") @db.VarChar(32)
  avatarUrl              String?            @map("avatar_url") @db.VarChar(500)
  passwordHash           String             @map("password_hash")
  emailVerifiedAt        DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  countryCode            String?            @map("country_code") @db.Char(2)
  twoFactorEnabled       Boolean            @default(false) @map("two_factor_enabled")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions               Session[]
  ownedServers           Server[]           @relation("ServerOwner")
  memberships            ServerMember[]
  roleAssignments        ServerMemberRole[]
  bans                   ServerBan[]        @relation("BannedUser")
  bansCreated            ServerBan[]        @relation("BanCreator")
  invites                Invite[]           @relation("InviteCreator")
  messages               Message[]          @relation("MessageAuthor")
  reactions              MessageReaction[]
  emailTokens            EmailToken[]
  friendshipsRequested   Friendship[]       @relation("FriendRequester")
  friendshipsReceived    Friendship[]       @relation("FriendAddressee")
  directMessagesSent     DirectMessage[]    @relation("DirectSender")
  directMessagesReceived DirectMessage[]    @relation("DirectRecipient")
  reportsCreated         Report[]           @relation("ReportCreator")
  reportsTargeting       Report[]           @relation("ReportTarget")

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model Server {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(40)
  iconUrl   String?        @map("icon_url") @db.VarChar(500)
  ownerId   String         @map("owner_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  owner     User           @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   ServerMember[]
  roles     ServerRole[]
  invites   Invite[]
  channels  Channel[]
  bans      ServerBan[]

  @@map("servers")
}

model ServerMember {
  serverId    String             @map("server_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  role        String             @default("member") @db.VarChar(16)
  permissions String[]           @default([])
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  server      Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLinks   ServerMemberRole[]

  @@id([serverId, userId])
  @@index([userId], map: "server_members_user_idx")
  @@map("server_members")
}

model EmailToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  purpose   String   @db.VarChar(32)
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "email_tokens_user_purpose_idx")
  @@map("email_tokens")
}

model Friendship {
  requesterId String   @map("requester_id") @db.Uuid
  addresseeId String   @map("addressee_id") @db.Uuid
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId, status], map: "friendships_addressee_idx")
  @@map("friendships")
}

model DirectMessage {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  content     String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  sender      User      @relation("DirectSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("DirectRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt(sort: Desc)], map: "direct_messages_sender_idx")
  @@index([recipientId, senderId, createdAt(sort: Desc)], map: "direct_messages_recipient_idx")
  @@map("direct_messages")
}

model Report {
  id           String   @id @default(uuid()) @db.Uuid
  reporterId   String   @map("reporter_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  serverId     String?  @map("server_id") @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid
  reason       String   @db.VarChar(1000)
  status       String   @default("open") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reporter     User     @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([serverId, status, createdAt], map: "reports_server_idx")
  @@map("reports")
}

model Invite {
  code      String   @id @db.VarChar(16)
  serverId  String   @map("server_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator   User     @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("invites")
}

model Channel {
  id         String              @id @default(uuid()) @db.Uuid
  serverId   String              @map("server_id") @db.Uuid
  name       String              @db.VarChar(32)
  type       String              @default("text") @db.VarChar(16)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  server     Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages   Message[]
  roleAccess ChannelRoleAccess[]

  @@index([serverId, createdAt], map: "channels_server_idx")
  @@map("channels")
}

model PermissionDefinition {
  key         String                 @id @db.VarChar(80)
  label       String                 @db.VarChar(80)
  description String                 @db.VarChar(240)
  category    String                 @db.VarChar(32)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       ServerRolePermission[]

  @@map("permission_definitions")
}

model ServerRole {
  id          String                 @id @default(uuid()) @db.Uuid
  serverId    String                 @map("server_id") @db.Uuid
  name        String                 @db.VarChar(40)
  color       String                 @default("#64748b") @db.VarChar(7)
  position    Int                    @default(0)
  isDefault   Boolean                @default(false) @map("is_default")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  server      Server                 @relation(fields: [serverId], references: [id], onDelete: Cascade)
  permissions ServerRolePermission[]
  members     ServerMemberRole[]
  channels    ChannelRoleAccess[]

  @@unique([serverId, name])
  @@index([serverId, position], map: "server_roles_position_idx")
  @@map("server_roles")
}

model ServerRolePermission {
  roleId        String               @map("role_id") @db.Uuid
  permissionKey String               @map("permission_key") @db.VarChar(80)
  role          ServerRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    PermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("server_role_permissions")
}

model ServerMemberRole {
  serverId String       @map("server_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  roleId   String       @map("role_id") @db.Uuid
  member   ServerMember @relation(fields: [serverId, userId], references: [serverId, userId], onDelete: Cascade)
  role     ServerRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  @@id([serverId, userId, roleId])
  @@index([roleId], map: "server_member_roles_role_idx")
  @@map("server_member_roles")
}

model ChannelRoleAccess {
  channelId String     @map("channel_id") @db.Uuid
  roleId    String     @map("role_id") @db.Uuid
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      ServerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([channelId, roleId])
  @@index([roleId], map: "channel_role_access_role_idx")
  @@map("channel_role_access")
}

model ServerBan {
  serverId  String   @map("server_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  creator   User     @relation("BanCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId], map: "server_bans_user_idx")
  @@map("server_bans")
}

model Message {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  channelId       String            @map("channel_id") @db.Uuid
  content         String
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?         @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)
  replyToId       String?           @map("reply_to_id") @db.Uuid
  legacyReactions Json              @default("{}") @map("reactions")
  mediaUrl        String?           @map("media_url")
  mediaType       String?           @map("media_type") @db.VarChar(16)
  mediaAlt        String?           @map("media_alt") @db.VarChar(160)
  author          User              @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  channel         Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo         Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]         @relation("MessageReplies")
  reactionEntries MessageReaction[]

  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)], map: "messages_created_idx")
  @@map("messages")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId], map: "message_reactions_user_idx")
  @@map("message_reactions")
}
