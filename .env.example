# Public port exposed by the reverse proxy.
APP_PORT=8080
# Exact browser origin allowed by the API when it is accessed directly.
APP_ORIGIN=http://localhost:8080

# PostgreSQL credentials used by Docker Compose. Use a strong password in production.
POSTGRES_DB=huddle
POSTGRES_USER=huddle
POSTGRES_PASSWORD=huddle
# Keep this URL aligned with the credentials above, or point it at managed PostgreSQL.
DATABASE_URL=postgresql://huddle:huddle@database:5432/huddle?schema=public

# Optional but recommended outside a local network. TURN credentials are sent
# to authenticated browsers and should be short-lived in production.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: Tenor stopped accepting new API clients in January 2026. These
# settings only apply if you already have an active Tenor API key.
TENOR_API_KEY=
TENOR_CLIENT_KEY=huddle
