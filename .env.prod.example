# Domínio público roteado pelo Traefik, sem protocolo.
APP_DOMAIN=huddle.example.com
# Origem exata usada pelo navegador e permitida pela API.
APP_ORIGIN=https://huddle.example.com

# PostgreSQL. Use credenciais fortes em produção.
POSTGRES_DB=huddle
POSTGRES_USER=huddle
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://huddle:troque-esta-senha@database:5432/huddle?schema=public

# Opcional, mas recomendado para chamadas em redes restritivas.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

TENOR_API_KEY=
TENOR_CLIENT_KEY=huddle
SERPRO_AGE_VERIFICATION_URL=
SERPRO_AGE_VERIFICATION_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Huddle <no-reply@example.com>
MODERATION_EMAIL=
